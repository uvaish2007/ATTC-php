# ATTS IQAC Portal — environment template
# Copy this file to ".env" and fill in your own values:
#     cp .env.example .env
# The .env file holds secrets and is NOT committed to version control.

# --- MySQL connection ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=atts_main
DB_USER=root
DB_PASS=

# --- Application ---
# "/php-app" when served from XAMPP htdocs; "" when the folder is the web root.
BASE_URL=/php-app

# Keep false in production so error details are never shown to visitors.
APP_DEBUG=false

APP_TIMEZONE=Asia/Kolkata
SESSION_NAME=atts_session
