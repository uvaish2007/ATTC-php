# ===========================================================================
#  ATTS IQAC Portal — PHP + MySQL
#  (the old React/Node app was removed; this repo is the php-app/ project)
# ===========================================================================

# --- Secrets: never commit real credentials (use php-app/.env.example) ---
.env
php-app/.env
*.env.local
*.env.*.local

# --- Full database dump (real users + bcrypt password hashes + real records) ---
#   THIS REPO IS PUBLIC — never commit a data dump here. Share database.sql with
#   teammates privately (direct file / private drive), or make the repo private.
php-app/sql/database.sql

# --- Portable PHP runtime (~90 MB of Windows x64 binaries) ---
#   Not committed. To run: download PHP 8.4 NTS x64 and unzip into
#   .php-runtime/ (see start-server.bat), or serve php-app/ with XAMPP.
.php-runtime/

# --- Unused Python virtual environment ---
.venv/

# --- Legacy Node / React artefacts (the SPA was removed) ---
node_modules/
vendor/
backend/
frontend/

# --- Uploaded proof documents: real faculty records, never commit ---
php-app/uploads/*
!php-app/uploads/.gitkeep
!php-app/uploads/.htaccess

# --- Local reference docs (they embed the DB password / real report data) ---
DATABASE-GUIDE.*
*.doc
*.docx

# --- Tooling / local-only ---
.claude/
tree-maker/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/

# --- Logs / temporary files ---
logs/
*.log
*.tmp
*.temp
*.local
coverage/

# --- Real-data spreadsheets & editor workspace (public repo) ---
*.xlsx
*.code-workspace
